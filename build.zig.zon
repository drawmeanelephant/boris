.{
    .name = .boris,
    .version = "0.8.1",
    .fingerprint = 0x6cd378330da76efc, // Changing this has security and trust implications.
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // Oliver pin (shared). oliver#39 merged (c0b3d2b): the Markdown
        // renderer extensions (heading auto-ids, IALs, footnotes, definition
        // lists, GFM strikethrough) and the Cooklang stack now share one
        // revision, so the former `.oliver_cooklang` split pin collapsed back
        // into `.oliver`. See docs/contracts/oliver-renderer.md for the pin
        // table.
        .oliver = .{
            .url = "https://github.com/drawmeanelephant/oliver/archive/c0b3d2b683f0cecf2181b22a800908619e56d0d7.tar.gz",
            .hash = "oliver-0.0.0-LOsZkAe_HwD1k4BLmgWJcT9AI3AopaxmZwjc2gx-23pz",
        },
        .secp256k1 = .{
            .url = "git+https://github.com/bitcoin-core/secp256k1#6e2c8bc4ecdc6e71dbe7a368f360d8d453ce435d",
            .hash = "N-V-__8AAFwQbQAc-L8ZUw4rqyk_OWdYX4-V8crqiWlJ1dhl",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "tools",
        "fixtures",
        "docs",
        "LICENSE",
        "README.md",
    },
}
