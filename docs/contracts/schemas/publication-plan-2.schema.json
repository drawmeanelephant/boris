{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Boris publication plan with explicit NIP-42 policy (schema 2)",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schema_version", "input", "input_format", "site", "targets", "editions", "nostr"],
  "properties": {
    "format": { "const": "boris-publication-plan" },
    "schema_version": { "const": 2 },
    "input": { "$ref": "publication-plan-1.schema.json#/$defs/path" },
    "input_format": { "enum": ["markdown", "textile", "cook"] },
    "site": { "$ref": "publication-plan-1.schema.json#/$defs/site" },
    "publication": { "$ref": "publication-plan-1.schema.json#/$defs/publication" },
    "targets": { "type": "array", "items": { "$ref": "publication-plan-1.schema.json#/$defs/target" } },
    "editions": { "$ref": "publication-plan-1.schema.json#/$defs/editions" },
    "nostr": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "kind", "pubkey", "articles", "relays", "timeout_ms", "retries", "auth"],
      "properties": {
        "enabled": { "const": true }, "kind": { "const": 30023 },
        "pubkey": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "articles": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "type": "string" } },
        "relays": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "string" } },
        "timeout_ms": { "type": "integer", "minimum": 100, "maximum": 60000 },
        "retries": { "type": "integer", "minimum": 0, "maximum": 5 },
        "auth": { "$ref": "publication-profile-1.schema.json#/$defs/nostr/properties/auth" }
      }
    }
  }
}
