{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Boris frontmatter grammar (schema v1)",
  "description": "JSON view of the closed author-facing frontmatter grammar (docs/contracts/frontmatter.md). Frontmatter source is not JSON: tools convert the parsed field set to this object shape before validating. Keys absent from the source are null. The key set is closed — additionalProperties:false is normative, matching the product parser's unknown-key rejection.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": { "type": ["string", "null"], "minLength": 1, "maxLength": 255 },
    "title": { "type": ["string", "null"], "maxLength": 512 },
    "parent": { "type": ["string", "null"], "minLength": 1, "maxLength": 255 },
    "status": { "type": ["string", "null"], "enum": ["draft", "published", "archived", null] },
    "tags": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 64 }
    },
    "relations": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "target"],
        "properties": {
          "kind": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
          "target": { "type": "string", "minLength": 1, "maxLength": 255 }
        }
      }
    },
    "published_at": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "summary": { "type": ["string", "null"], "maxLength": 1024 }
  }
}
