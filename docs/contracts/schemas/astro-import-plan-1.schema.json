{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drawmeanelephant.github.io/boris/schemas/astro-import-plan-1.schema.json",
  "title": "Boris Astro import plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [ "plan_digest", "digest_input" ],
  "properties": {
    "plan_digest": { "$ref": "#/$defs/sha256" },
    "digest_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "schema_version",
        "canonical_json",
        "digest_algorithm",
        "source_snapshot_digest",
        "importer_policy_digest",
        "previous_manifest_digest",
        "proposed_actions",
        "findings"
      ],
      "properties": {
        "format": { "const": "boris-astro-import-plan" },
        "schema_version": { "const": 1 },
        "canonical_json": { "type": "string", "minLength": 1 },
        "digest_algorithm": { "const": "sha256-lowercase-hex" },
        "source_snapshot_digest": { "$ref": "#/$defs/sha256" },
        "importer_policy_digest": { "$ref": "#/$defs/sha256" },
        "previous_manifest_digest": {
          "anyOf": [ { "$ref": "#/$defs/sha256" }, { "type": "null" } ]
        },
        "proposed_actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/planAction" }
        },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/finding" }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "importRecordId": {
      "type": "string",
      "pattern": "^air_[0-9a-f]{64}$"
    },
    "normalizedRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//).+$"
    },
    "proposedSourcePath": {
      "type": "string",
      "minLength": 9,
      "pattern": "^content/(?!\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//).+\\.md$"
    },
    "entityId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[\\s#?%]).+$"
    },
    "routeCandidate": {
      "$ref": "#/$defs/entityId"
    },
    "actionClass": {
      "enum": [
        "create",
        "keep",
        "quarantine",
        "unsupported",
        "review",
        "conflict"
      ]
    },
    "reasonCode": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "closedFrontmatter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/entityId" },
        "title": { "type": "string", "minLength": 1, "maxLength": 512 },
        "status": { "enum": [ "draft", "published", "archived" ] },
        "tags": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 64 }
        }
      }
    },
    "planAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "import_record_id",
        "source_path",
        "source_hash",
        "proposed_boris_source_path",
        "proposed_entity_id",
        "authored_frontmatter_evidence",
        "proposed_closed_frontmatter",
        "inferred_source_route_candidate",
        "proposed_boris_route",
        "route_compatibility",
        "preconditions",
        "loss_classification",
        "reason"
      ],
      "properties": {
        "class": { "$ref": "#/$defs/actionClass" },
        "import_record_id": {
          "anyOf": [ { "$ref": "#/$defs/importRecordId" }, { "type": "null" } ]
        },
        "source_path": { "$ref": "#/$defs/normalizedRelativePath" },
        "source_hash": {
          "anyOf": [ { "$ref": "#/$defs/sha256" }, { "type": "null" } ]
        },
        "proposed_boris_source_path": {
          "anyOf": [ { "$ref": "#/$defs/proposedSourcePath" }, { "type": "null" } ]
        },
        "proposed_entity_id": {
          "anyOf": [ { "$ref": "#/$defs/entityId" }, { "type": "null" } ]
        },
        "authored_frontmatter_evidence": {
          "type": [ "string", "null" ]
        },
        "proposed_closed_frontmatter": { "$ref": "#/$defs/closedFrontmatter" },
        "inferred_source_route_candidate": {
          "anyOf": [ { "$ref": "#/$defs/routeCandidate" }, { "type": "null" } ]
        },
        "proposed_boris_route": {
          "anyOf": [ { "$ref": "#/$defs/routeCandidate" }, { "type": "null" } ]
        },
        "route_compatibility": { "const": "inferred_not_observed" },
        "preconditions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "loss_classification": {
          "enum": [ "review_required_not_applied", "not_convertible" ]
        },
        "reason": { "$ref": "#/$defs/reasonCode" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "class": { "enum": [ "create", "keep" ] }
            },
            "required": [ "class" ]
          },
          "then": {
            "properties": {
              "import_record_id": { "$ref": "#/$defs/importRecordId" },
              "source_hash": { "$ref": "#/$defs/sha256" },
              "proposed_boris_source_path": { "$ref": "#/$defs/proposedSourcePath" },
              "proposed_entity_id": { "$ref": "#/$defs/entityId" },
              "inferred_source_route_candidate": { "$ref": "#/$defs/routeCandidate" },
              "proposed_boris_route": { "$ref": "#/$defs/routeCandidate" },
              "preconditions": { "minItems": 1 },
              "loss_classification": { "const": "review_required_not_applied" }
            }
          },
          "else": {
            "properties": {
              "preconditions": { "maxItems": 0 },
              "loss_classification": { "const": "not_convertible" }
            }
          }
        }
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "class", "reason", "source_paths" ],
      "properties": {
        "class": { "enum": [ "review", "conflict" ] },
        "reason": { "$ref": "#/$defs/reasonCode" },
        "source_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/normalizedRelativePath" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "class": { "const": "conflict" } },
            "required": [ "class" ]
          },
          "then": {
            "properties": {
              "source_paths": { "minItems": 2 }
            }
          }
        }
      ]
    }
  }
}
