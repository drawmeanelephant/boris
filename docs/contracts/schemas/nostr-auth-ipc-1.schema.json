{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Boris private anonymous-pipe NIP-42 messages",
  "description": "32,768 UTF-8 bytes including a strict JSON payload, preceded by a 4-byte big-endian length. Byte lengths and nesting <= 8 are enforced by the implementation. No key material.",
  "oneOf": [
    { "$ref": "#/$defs/ready" }, { "$ref": "#/$defs/begin" },
    { "$ref": "#/$defs/request" }, { "$ref": "#/$defs/response" },
    { "$ref": "#/$defs/control" }, { "$ref": "#/$defs/finish" }
  ],
  "$defs": {
    "format": { "const": "boris-nostr-auth-ipc" },
    "version": { "const": 1 },
    "hex64": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nonce": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "revision": { "const": "656cecc7c0a815b6a2b218d3b5d6f078b3f4dbab" },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["plan_digest", "bundle_digest", "nips_revision", "pubkey", "relays", "timeout_ms"],
      "properties": {
        "plan_digest": { "$ref": "#/$defs/hex64" }, "bundle_digest": { "$ref": "#/$defs/hex64" },
        "nips_revision": { "$ref": "#/$defs/revision" }, "pubkey": { "$ref": "#/$defs/hex64" },
        "relays": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 1024 } },
        "timeout_ms": { "type": "integer", "minimum": 100, "maximum": 60000 }
      }
    },
    "correlation": {
      "type": "object", "additionalProperties": false,
      "required": ["plan_digest", "bundle_digest", "nips_revision", "run", "connection", "request", "relay", "generation"],
      "properties": {
        "plan_digest": { "$ref": "#/$defs/hex64" }, "bundle_digest": { "$ref": "#/$defs/hex64" },
        "nips_revision": { "$ref": "#/$defs/revision" }, "run": { "$ref": "#/$defs/nonce" },
        "connection": { "$ref": "#/$defs/nonce" }, "request": { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 },
        "relay": { "type": "string", "minLength": 1, "maxLength": 1024 }, "generation": { "enum": [1, 2] }
      }
    },
    "event": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "pubkey", "created_at", "kind", "tags", "content", "sig"],
      "properties": {
        "id": { "$ref": "#/$defs/hex64" }, "pubkey": { "$ref": "#/$defs/hex64" },
        "created_at": { "type": "integer", "minimum": 0 }, "kind": { "const": 22242 }, "content": { "const": "" },
        "sig": { "type": "string", "pattern": "^[0-9a-f]{128}$" },
        "tags": { "type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [
          { "type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{ "const": "relay" }, { "type": "string", "maxLength": 1024 }] },
          { "type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{ "const": "challenge" }, { "type": "string", "minLength": 1, "maxLength": 4096 }] }
        ] }
      }
    },
    "ready": {
      "type": "object", "additionalProperties": false, "required": ["format", "version", "type", "policy"],
      "properties": { "format": { "$ref": "#/$defs/format" }, "version": { "$ref": "#/$defs/version" }, "type": { "const": "ready" }, "policy": { "$ref": "#/$defs/policy" } }
    },
    "begin": {
      "type": "object", "additionalProperties": false, "required": ["format", "version", "type", "run"],
      "properties": { "format": { "$ref": "#/$defs/format" }, "version": { "$ref": "#/$defs/version" }, "type": { "const": "begin" }, "run": { "$ref": "#/$defs/nonce" } }
    },
    "request": {
      "type": "object", "additionalProperties": false, "required": ["format", "version", "type", "correlation", "challenge"],
      "properties": { "format": { "$ref": "#/$defs/format" }, "version": { "$ref": "#/$defs/version" }, "type": { "const": "sign" }, "correlation": { "$ref": "#/$defs/correlation" }, "challenge": { "type": "string", "minLength": 1, "maxLength": 4096 } }
    },
    "response": {
      "type": "object", "additionalProperties": false, "required": ["format", "version", "type", "correlation", "refusal", "event"],
      "properties": { "format": { "$ref": "#/$defs/format" }, "version": { "$ref": "#/$defs/version" }, "type": { "const": "response" }, "correlation": { "$ref": "#/$defs/correlation" }, "refusal": { "enum": [null, "signer-refused"] }, "event": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/event" }] } },
      "oneOf": [{ "properties": { "refusal": { "const": null }, "event": { "$ref": "#/$defs/event" } } }, { "properties": { "refusal": { "const": "signer-refused" }, "event": { "const": null } } }]
    },
    "control": {
      "type": "object", "additionalProperties": false, "required": ["format", "version", "type", "correlation"],
      "properties": { "format": { "$ref": "#/$defs/format" }, "version": { "$ref": "#/$defs/version" }, "type": { "enum": ["cancel", "retire"] }, "correlation": { "$ref": "#/$defs/correlation" } }
    },
    "finish": {
      "type": "object", "additionalProperties": false, "required": ["format", "version", "type"],
      "properties": { "format": { "$ref": "#/$defs/format" }, "version": { "$ref": "#/$defs/version" }, "type": { "const": "finish" } }
    }
  }
}
