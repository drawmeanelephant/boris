{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Boris publication plan with target-owned head metadata (schema 3)",
  "description": "Declaration only. Optional target-local head and HTML serialization policy; existing NIP-42 policy remains explicit.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schema_version", "input", "input_format", "site", "targets", "editions"],
  "properties": {
    "format": { "const": "boris-publication-plan" },
    "schema_version": { "const": 3 },
    "input": { "$ref": "publication-plan-1.schema.json#/$defs/path" },
    "input_format": { "enum": ["markdown", "textile", "cook"] },
    "site": { "$ref": "publication-plan-1.schema.json#/$defs/site" },
    "publication": { "$ref": "publication-plan-1.schema.json#/$defs/publication" },
    "targets": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/target" } },
    "editions": { "$ref": "publication-plan-1.schema.json#/$defs/editions" },
    "nostr": {
      "oneOf": [
        { "$ref": "publication-plan-1.schema.json#/$defs/nostr" },
        { "$ref": "publication-plan-2.schema.json#/properties/nostr" }
      ]
    }
  },
  "$defs": {
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "output", "public", "theme", "layout", "layout_rules", "projections"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "output": { "$ref": "publication-plan-1.schema.json#/$defs/path" },
        "public": { "type": "boolean" },
        "theme": { "$ref": "publication-plan-1.schema.json#/$defs/nullable_path" },
        "layout": { "$ref": "publication-plan-1.schema.json#/$defs/nullable_path" },
        "layout_rules": { "type": "array", "maxItems": 256, "items": { "$ref": "publication-plan-1.schema.json#/$defs/layout_rule" } },
        "projections": { "$ref": "publication-plan-1.schema.json#/$defs/projections" },
        "html_profile": { "enum": ["html", "xhtml", "html4_strict"] },
        "head": {
          "allOf": [
            { "$ref": "publication-profile-1.schema.json#/$defs/head" },
            { "required": ["enabled", "ogp", "defaults", "pages"] }
          ]
        }
      }
    }
  }
}
