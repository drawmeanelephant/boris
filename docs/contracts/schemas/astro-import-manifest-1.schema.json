{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drawmeanelephant.github.io/boris/schemas/astro-import-manifest-1.schema.json",
  "title": "Boris Astro completed import manifest evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "project_id",
    "policy_digest",
    "records"
  ],
  "properties": {
    "format": { "const": "boris-astro-import-manifest" },
    "schema_version": { "const": 1 },
    "project_id": { "$ref": "#/$defs/projectId" },
    "policy_digest": { "$ref": "#/$defs/sha256" },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/manifestRecord" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "projectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "normalizedRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//).+$"
    },
    "importRecordId": {
      "type": "string",
      "pattern": "^air_[0-9a-f]{64}$"
    },
    "manifestRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "source_path", "import_record_id" ],
      "properties": {
        "source_path": { "$ref": "#/$defs/normalizedRelativePath" },
        "import_record_id": { "$ref": "#/$defs/importRecordId" }
      }
    }
  }
}
