{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Boris editor completion index (schema v1)",
  "description": "Deterministic editor completion surface derived from the frozen graph: entity ids (with title/parent/role/status/tags/relations for display), the relation-kind vocabulary, observed parent targets, and the closed layout-slot set. Published as completion.json alongside the IR artifact set on a successful freeze. Length bounds count Unicode code points (JSON Schema semantics); the values originate from parser-validated source, whose UTF-8 byte limits (frontmatter.md) are normative.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schema_version", "compiler_id", "frozen", "entities", "relation_kinds", "parent_targets", "layout_slots"],
  "properties": {
    "format": { "const": "boris-completion-index" },
    "schema_version": { "const": 1 },
    "compiler_id": { "type": "string", "minLength": 1 },
    "frozen": { "type": "boolean" },
    "entities": {
      "type": "array",
      "items": { "$ref": "#/$defs/entity" }
    },
    "relation_kinds": {
      "type": "array",
      "items": { "$ref": "#/$defs/relation_kind" }
    },
    "parent_targets": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 255 }
    },
    "layout_slots": {
      "type": "array",
      "items": {
        "enum": ["backlinks", "breadcrumb", "children", "content", "footer", "metadata", "nav", "relations", "title", "toc"]
      }
    }
  },
  "$defs": {
    "relation_kind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "parent", "role", "status", "tags", "relations"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 255 },
        "title": { "type": ["string", "null"], "maxLength": 512 },
        "parent": { "type": ["string", "null"], "maxLength": 255 },
        "role": { "enum": ["trunk", "satellite"] },
        "status": { "type": ["string", "null"], "enum": ["draft", "published", "archived", null] },
        "tags": { "type": "array", "maxItems": 32, "items": { "type": "string", "maxLength": 64 } },
        "relations": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "target"],
            "properties": {
              "kind": { "$ref": "#/$defs/relation_kind" },
              "target": { "type": "string", "minLength": 1, "maxLength": 255 }
            }
          }
        }
      }
    }
  }
}
