    "title": "Boris Docs",
    "description": "Deterministic documentation, published to the Atmosphere."
  },
  "publication": {
    "target": "standard-site",
    "base_url": "https://docs.example.com",
    "origin": "https://docs.example.com",
    "base_path": "",
    "did": "did:plc:ewvi7nxzyoun6zhxrhs64oiz",
    "pds_origin": "https://pds.example.com",
    "name": "Boris Docs (Standard.site)",
