      "public": true,
      "theme": "themes/boris",
      "layout": null,
      "layout_rules": [],
      "projections": {
        "html": true,
        "sitemap": {"path": "sitemap.xml"},
        "rss": null,
        "llms": null
      }
    }
  ],
  "editions": {
    "ir": null,
    "rag": null,
    "context": null
  }
}
