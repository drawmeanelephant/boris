.{
    .name = .boris_migration_lab,
    .version = "0.1.0",
    .fingerprint = 0x3e8a1154a7c8f697, // generated by zig for this package identity
    .minimum_zig_version = "0.16.0",
    // The laboratory links Boris's parser in-process as the astro-import-apply
    // final gate (docs/contracts/astro-import-apply.md). It is consumed as a
    // package, never by a relative `../../src` path, so the tree stays
    // forkable (docs/plans/migration-lab-standalone-repo.md, 3.1a).
    //
    // In-repo freeze form: a path dependency on the repository root, so the
    // gate stays green without a published Boris tag. The standalone fork
    // replaces this with a URL + hash pinned to a released Boris tag.
    .dependencies = .{
        .boris = .{ .path = "../.." },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "main.zig",
        "wordpress.zig",
        "starlight.zig",
        "astro_import_plan.zig",
        "astro_import_apply.zig",
        "instagram.zig",
        "obsidian.zig",
        "notion.zig",
        "filed.zig",
        "filed_scan.zig",
        "asset_filename.zig",
        "theme_archaeology.zig",
        "theme_materialize.zig",
        "wordpress_theme.zig",
        "product_boris.zig",
        "layouts",
        "link_audit.zig",
        "frontmatter_review.zig",
        "migration_semantics.zig",
        "publication.zig",
        "archaeology.zig",
        "fixtures",
        "schema-validation",
        "README.md",
        ".gitignore",
    },
}
